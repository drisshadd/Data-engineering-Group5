# Copy to .env (never commit). Used by the ingestion job and the dashboard.
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=SKYHOP_INGEST_SVC
SNOWFLAKE_ROLE=SKYHOP_INGEST
SNOWFLAKE_WAREHOUSE=SKYHOP_WH
SNOWFLAKE_PRIVATE_KEY_FILE=keys/rsa_key.p8
# PostgreSQL started with docker-compose-databases.yml (course lab values, local only)
PGHOST=localhost
PGPORT=5432
PGUSER=source
PGPASSWORD=source_pw
PGDATABASE=project_source
