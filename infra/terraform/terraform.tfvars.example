# Copy to terraform.tfvars (git-ignored) and fill in.
# Values: in Snowsight run  SELECT CURRENT_ORGANIZATION_NAME(), CURRENT_ACCOUNT_NAME();
snowflake_organization_name = "ABCDEFG"
snowflake_account_name      = "XY12345"
snowflake_user              = "TERRAFORM_SVC"
# Windows (Git Bash): "C:/Users/<you>/.snowflake/terraform_key.p8"   macOS: "~/.snowflake/terraform_key.p8"
snowflake_private_key_path = "C:/Users/<you>/.snowflake/terraform_key.p8"
