# Copy to .env (same folder) and fill in. .env is git-ignored: it never goes to GitHub.
# Paths = ABSOLUTE paths on your Mac (run `echo $HOME` to get /Users/<you>). "~" does NOT work here.

# ---- Snowflake
SNOWFLAKE_ACCOUNT=DQYYEIS-EW25504

# Ingestion robot (role SKYHOP_INGEST) and the private key registered on it
INGEST_SNOWFLAKE_USER=SKYHOP_INGEST_SVC
INGEST_KEY_FILE=/Users/<you>/.snowflake/ingest_m3_key.p8

# dbt robot (role SKYHOP_TRANSFORM)
#   DBT_TARGET=keypair  -> DBT_SVC + its key (recommended)
#   DBT_TARGET=password -> fallback: the login you used for `dbt build` yesterday + its password
DBT_TARGET=keypair
DBT_SNOWFLAKE_USER=DBT_SVC
DBT_KEY_FILE=/Users/<you>/.snowflake/dbt_svc_key.p8
DBT_SNOWFLAKE_PASSWORD=

# ---- Data: the folder that contains skyhop/batch_001, skyhop/batch_002 (repo folder generator/out)
GENERATOR_OUT_DIR=/Users/<you>/Data-engineering-Group5/generator/out

# ---- Postgres (local throw-away lab values, same as the course: never reuse them anywhere)
PGUSER=source
PGPASSWORD=source_pw
PGDATABASE=project_source

# ---- Slack / Teams incoming webhook. Empty = the alert is written in the task log only.
ALERT_WEBHOOK_URL=
